{
  "name": "abr2painter",
  "version": "0.2.0",
  "description": "Convert Photoshop .abr brushes to Infinite Painter .prbr brushes",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "abr2painter": "./dist/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-ag-psd.mjs",
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
