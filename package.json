{
  "name": "abr2painter",
  "version": "0.2.0",
  "description": "Convert Photoshop .abr brushes to Infinite Painter .prbr brushes",
  "type": "module",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "abr2painter": "./dist/cli.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-ag-psd.mjs",
    "build": "tsc",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test-abr": "tsx scripts/make-test-abr.ts",
    "build:web": "esbuild src/convert.ts --bundle --format=esm --minify --outfile=docs/app.js --inject:scripts/web-shims.js --alias:node:crypto=./scripts/web-shims.js --alias:pngjs=pngjs/browser.js"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^20.0.0",
    "@types/pngjs": "^6.0.5",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
